# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-change-me-in-production-please-use-a-real-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (matches docker-compose.yml service names)
POSTGRES_DB=kodfolio
POSTGRES_USER=kodfolio
POSTGRES_PASSWORD=kodfolio_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (для Celery)
REDIS_URL=redis://redis:6379/0

# CORS (в dev разрешаем Angular)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# JWT lifetime в минутах
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Stripe (заполнишь когда будем интегрировать Stripe)
# STRIPE_MODE: "mock" = всё работает без реального Stripe; "live" = реальные API-вызовы
STRIPE_MODE=mock
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Payment splits (в процентах)
PLATFORM_FEE_PERCENT=10
MENTOR_FEE_PERCENT=5

# GitHub OAuth (для последующих фаз)
GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder

# Email (в dev — console backend, в prod — SES)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@kodfolio.com

# AWS (для последующих фаз)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
